'use client'

import { useState } from 'react'

export default function Navbar() {
	const [isOpen, setIsOpen] = useState(false)

	const links = [
		{ href: '#start', label: 'Start' },
		{ href: '#uslugi', label: 'Usługi' },
		{ href: '#o-nas', label: 'O nas' },
		{ href: '#realizacje', label: 'Realizacje' },
		{ href: '#kontakt', label: 'Kontakt' },
	]

	return (
		<nav className="fixed top-0 left-0 right-0 z-50 bg-gray-950/80 backdrop-blur-md border-b border-gray-800">
			<div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div className="flex items-center justify-between h-16">
					{/* Logo */}
					<a href="#start" className="flex items-center gap-2">
						<div className="w-10 h-10 bg-amber-500 rounded-lg flex items-center justify-center">
							<svg className="w-6 h-6 text-gray-950" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2.5} d="M13 10V3L4 14h7v7l9-11h-7z" />
							</svg>
						</div>
						<span className="text-xl font-bold">
							Elektro<span className="text-amber-500">Max</span>
						</span>
					</a>

					{/* Desktop links */}
					<div className="hidden md:flex items-center gap-8">
						{links.map(link => (
							<a
								key={link.href}
								href={link.href}
								className="text-sm text-gray-300 hover:text-amber-500 transition-colors duration-200 font-medium">
								{link.label}
							</a>
						))}
						<a
							href="tel:+48123456789"
							className="bg-amber-500 hover:bg-amber-600 text-gray-950 font-semibold px-5 py-2 rounded-lg transition-colors duration-200 text-sm">
							📞 Zadzwoń
						</a>
					</div>

					{/* Mobile hamburger */}
					<button
						className="md:hidden text-gray-300 hover:text-amber-500"
						onClick={() => setIsOpen(!isOpen)}
						aria-label="Menu">
						<svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							{isOpen ? (
								<path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
							) : (
								<path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 6h16M4 12h16M4 18h16" />
							)}
						</svg>
					</button>
				</div>
			</div>

			{/* Mobile menu */}
			{isOpen && (
				<div className="md:hidden bg-gray-900 border-t border-gray-800">
					<div className="px-4 py-4 space-y-3">
						{links.map(link => (
							<a
								key={link.href}
								href={link.href}
								onClick={() => setIsOpen(false)}
								className="block text-gray-300 hover:text-amber-500 transition-colors font-medium">
								{link.label}
							</a>
						))}
						<a
							href="tel:+48123456789"
							className="block bg-amber-500 hover:bg-amber-600 text-gray-950 font-semibold px-5 py-2.5 rounded-lg text-center transition-colors">
							📞 Zadzwoń teraz
						</a>
					</div>
				</div>
			)}
		</nav>
	)
}
